# Environment Variables for Interprelo Famous AI

# OpenAI API Configuration
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_OPENAI_MODEL=gpt-4o-mini

# Anthropic API Configuration (Alternative)
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here
VITE_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# LLM Provider Selection (openai or anthropic)
VITE_LLM_PROVIDER=openai

# Speech Configuration
VITE_SPEECH_LANGUAGE=en-US
VITE_TTS_VOICE=en-US-Neural2-A
VITE_TTS_RATE=1.0
VITE_TTS_PITCH=1.0

# Feature Flags
VITE_ENABLE_AI_SCENARIOS=true
VITE_ENABLE_VOICE_ANALYSIS=true
VITE_ENABLE_COACHING=true

# Supabase Configuration (if using authentication)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# API Rate Limiting
VITE_MAX_REQUESTS_PER_MINUTE=20
VITE_MAX_TOKENS_PER_REQUEST=500

# Debug Mode
VITE_DEBUG_MODE=false
